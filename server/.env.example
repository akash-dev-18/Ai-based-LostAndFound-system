ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://lostfound:lostfound@localhost:5432/lostfound
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=lf_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

CACHE_ENABLED=true
CACHE_ITEM_LIST_TTL_SECONDS=30
CACHE_ITEM_DETAIL_TTL_SECONDS=60
CACHE_RAG_TTL_SECONDS=60

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_CLAIMS_PER_HOUR=10
RATE_LIMIT_CHATBOT_PER_MINUTE=20

STORAGE_DIR=storage
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_IMAGES_PER_ITEM=5
MEDIA_URL_EXPIRE_SECONDS=900

AI_TEXT_MODEL=BAAI/bge-small-en-v1.5
AI_TEXT_DIMENSIONS=384
AI_IMAGE_MODEL=openai/clip-vit-base-patch32
AI_IMAGE_DIMENSIONS=512
AI_DEVICE=cpu
AI_TASKS_ENABLED=true
AI_MATCH_CANDIDATE_LIMIT=50
AI_MATCH_MIN_SCORE=0.70
AI_MATCH_NOTIFY_THRESHOLD=0.90
AI_MATCH_TEXT_WEIGHT=0.45
AI_MATCH_IMAGE_WEIGHT=0.35
AI_MATCH_ATTRIBUTE_WEIGHT=0.20

AI_RAG_CHUNK_SIZE=800
AI_RAG_CHUNK_OVERLAP=120
AI_RAG_CANDIDATE_LIMIT=20
AI_RAG_TOP_K=5
AI_RAG_RRF_K=60
AI_RAG_MIN_VECTOR_SCORE=0.55
AI_RAG_MAX_CONTEXT_CHARS=6000
AI_AGENT_MAX_STEPS=4
AI_AGENT_TOOL_TIMEOUT_SECONDS=20.0
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_LLM_TIMEOUT_SECONDS=20.0
AI_LLM_MAX_TOKENS=600

POSTGRES_USER=lostfound
POSTGRES_PASSWORD=lostfound
POSTGRES_DB=lostfound
POSTGRES_PORT=5432
REDIS_PORT=6379
